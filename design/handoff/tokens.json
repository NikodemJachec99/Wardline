{
  "$description": "Wardline design tokens. Names are the contract with Flutter (WlTokens). Light theme only.",
  "color": {
    "primary": { "value": "#0E9FA6", "note": "Brand fills only: Scan button, app icon, focus ring, charts. 3.2:1 on white, never text." },
    "primary.pressed": { "value": "#0B858B" },
    "primary.soft": { "value": "#E4F5F6" },
    "primary.ink": { "value": "#0A7F85", "note": "Button fills with text, teal text, links. 4.8:1." },
    "primary.inkPressed": { "value": "#086A6F" },
    "bg.page": { "value": "#FAFBFC" },
    "bg.surface": { "value": "#FFFFFF" },
    "bg.subtle": { "value": "#F3F5F8" },
    "border": { "value": "#E4E8EE" },
    "border.strong": { "value": "#CBD2DB" },
    "text.primary": { "value": "#0F1720" },
    "text.secondary": { "value": "#5B6675" },
    "text.disabled": { "value": "#9AA3AF" },
    "text.onPrimary": { "value": "#FFFFFF" },
    "status.admitted": { "base": "#2F6FEB", "fg": "#1F55C2", "bg": "#EAF1FD", "icon": "log-in", "label": "Admitted" },
    "status.inTreatment": { "base": "#7C4DDB", "fg": "#6236C0", "bg": "#F1ECFC", "icon": "activity", "label": "In Treatment" },
    "status.ready": { "base": "#14A35B", "fg": "#0D7A43", "bg": "#E6F6EE", "icon": "circle-check", "label": "Ready for Discharge", "short": "Ready" },
    "status.discharged": { "base": "#8A94A3", "fg": "#4F5967", "bg": "#F0F2F5", "icon": "log-out", "label": "Discharged" },
    "occupancy.low": { "value": "#22B573", "tint": "#E3F6EC", "range": "<60%" },
    "occupancy.medium": { "value": "#F29A2E", "tint": "#FDF0DD", "range": "60–85%" },
    "occupancy.high": { "value": "#E5484D", "tint": "#FCE6E7", "fg": "#A82622", "range": ">85%" },
    "role.nurse": { "ring": "#0E9FA6", "bg": "#E4F5F6", "fg": "#0A7F85" },
    "role.doctor": { "ring": "#7C4DDB", "bg": "#F1ECFC", "fg": "#6236C0" },
    "role.admin": { "ring": "#4F5967", "bg": "#F0F2F5", "fg": "#4F5967" },
    "danger": { "value": "#C9302C", "pressed": "#A82622", "bg": "#FDECEC" },
    "warning": { "value": "#D97F0E", "fg": "#8A5207", "bg": "#FFF6E8", "border": "#F6D9A8" },
    "success": { "alias": "status.ready" },
    "info": { "alias": "status.admitted" },
    "scrim": { "value": "#0F1720", "opacity": 0.32 },
    "glass": { "fill": "#FFFFFF", "fillOpacity": 0.72, "border": "#FFFFFF", "borderOpacity": 0.6, "blur": 0, "note": "No BackdropFilter, see README decision 5." },
    "gradient.dashboardHeader": { "angle": 340, "stops": ["#13A8AE", "#0A7F85"], "note": "Dark end top-left, under the white greeting text." }
  },
  "type": {
    "family": "Inter",
    "display": { "size": 34, "line": 40, "weight": 700, "tracking": -0.02 },
    "title1": { "size": 28, "line": 34, "weight": 700, "tracking": -0.02 },
    "title2": { "size": 22, "line": 28, "weight": 600, "tracking": -0.01 },
    "title3": { "size": 18, "line": 24, "weight": 600 },
    "body": { "size": 16, "line": 24, "weight": 400 },
    "label": { "size": 16, "line": 24, "weight": 600 },
    "callout": { "size": 15, "line": 20, "weight": 500 },
    "subhead": { "size": 14, "line": 20, "weight": 400 },
    "caption": { "size": 12, "line": 16, "weight": 500 },
    "overline": { "size": 11, "line": 14, "weight": 600, "tracking": 0.06, "uppercase": true },
    "kpi": { "size": 32, "line": 36, "weight": 600, "tracking": -0.02, "features": ["tnum"] },
    "id": { "size": 13, "line": 18, "weight": 500, "tracking": 0.02, "features": ["tnum", "zero"] }
  },
  "space": { "xxs": 4, "xs": 8, "sm": 12, "md": 16, "lg": 24, "xl": 32, "xxl": 48 },
  "size": { "touchMin": 48, "action": 56, "input": 48, "navBar": 64, "scanButton": 64, "gutter": 16 },
  "radius": { "chip": 8, "input": 12, "card": 16, "sheet": 24, "full": 999 },
  "elevation": {
    "0": "border only",
    "1": [{ "y": 1, "blur": 2, "color": "#0F1720", "opacity": 0.04 }, { "y": 2, "blur": 8, "color": "#0F1720", "opacity": 0.04 }],
    "2": [{ "y": 6, "blur": 20, "color": "#0F1720", "opacity": 0.08 }],
    "3": [{ "y": -8, "blur": 32, "color": "#0F1720", "opacity": 0.12 }]
  },
  "motion": {
    "fast": 120, "base": 220, "slow": 380,
    "easing.out": "Curves.easeOutCubic (cubic-bezier .33,1,.68,1)",
    "sheetSpring": { "mass": 1, "stiffness": 420, "damping": 38 }
  },
  "icon": { "set": "Lucide", "stroke": 1.75, "sizes": [16, 20, 24] }
}
